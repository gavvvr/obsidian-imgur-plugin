{
  "compilerOptions": {
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "esnext",
    "target": "es2021",
    "strict": false,
    "allowJs": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "moduleResolution": "bundler",
    "rootDir": ".",
    "isolatedModules": true,
    "lib": ["DOM", "DOM.Iterable", "ES2021"],
    "strictBindCallApply": true
  },
  "include": ["**/*.ts"],
  "exclude": ["test/e2e/**"]
}
