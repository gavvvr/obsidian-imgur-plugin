{
  "name": "obsidian-imgur-plugin",
  "description": "This plugin uploads images from your clipboard to imgur.com and embeds uploaded image to your note",
  "main": "main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "test": "vitest --coverage",
    "build": "tsc -noEmit -skipLibCheck && node scripts/esbuild.build.js production",
    "build-fast": "node scripts/esbuild.build.js production",
    "prepare": "git config core.hooksPath .githooks/",
    "commit": "git-cz",
    "pretest:e2e": "run-s build-fast",
    "test:e2e": "wdio run ./test/e2e/wdio.conf.ts",
    "test:eslint": "eslint --cache"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "keywords": [
    "obsidian.md",
    "imgur.com"
  ],
  "author": "Kirill Gavrilov",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "catalog:commit",
    "@commitlint/config-conventional": "catalog:commit",
    "@commitlint/cz-commitlint": "catalog:commit",
    "@eslint/js": "catalog:codestyle",
    "@types/node": "catalog:types",
    "@vitest/coverage-v8": "catalog:testing",
    "@vitest/ui": "catalog:testing",
    "@wdio/cli": "catalog:wdio",
    "@wdio/electron-service": "catalog:wdio",
    "@wdio/globals": "catalog:wdio",
    "@wdio/local-runner": "catalog:wdio",
    "@wdio/mocha-framework": "catalog:wdio",
    "@wdio/spec-reporter": "catalog:wdio",
    "commitizen": "catalog:commit",
    "electron": "catalog:types",
    "enquirer": "catalog:devScripting",
    "esbuild": "catalog:build",
    "eslint": "catalog:codestyle",
    "eslint-plugin-perfectionist": "catalog:codestyle",
    "eslint-plugin-wdio": "catalog:codestyle",
    "expect-webdriverio": "catalog:wdio",
    "globals": "catalog:codestyle",
    "lint-staged": "catalog:devScripting",
    "npm-run-all2": "catalog:devScripting",
    "obsidian": "catalog:types",
    "obsidian-utils": "catalog:devScripting",
    "prettier": "catalog:codestyle",
    "typescript": "catalog:build",
    "typescript-eslint": "catalog:codestyle",
    "vitest": "catalog:testing",
    "webdriverio": "catalog:wdio"
  },
  "lint-staged": {
    "*.{ts,js,css,md}": "prettier --write",
    "*.ts": "eslint --cache --fix"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.0.0 || ^24.0.0 || ^26.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12.0.0",
      "onFail": "download"
    }
  }
}
